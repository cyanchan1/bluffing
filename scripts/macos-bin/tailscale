#!/usr/bin/env bash
# The macOS app bundles its CLI without necessarily adding it to PATH.
for app_binary in "/Applications/Tailscale.app/Contents/MacOS/Tailscale" \
                  "$HOME/Applications/Tailscale.app/Contents/MacOS/Tailscale"; do
  if [[ -x "$app_binary" ]]; then
    exec "$app_binary" "$@"
  fi
done
echo "Tailscale.app was not found in /Applications or ~/Applications." >&2
exit 127
